# Plan 24: with HEINZEL_AUTOTUNE on, configuring measures the machine CMake runs on and writes `heinzel::host`, a
# `Machine` (`schedule/machine.hpp`) of its values, into <build>/heinzel_tune/include/heinzel/host_machine.hpp. Included
# by the top-level CMakeLists.txt. The facts come from the compiler and the operating system in under a second, the rest
# from the probes beside this file, built with the build's compiler and flags and run one at a time, pinned with taskset
# where it can pin. Stage 1 (`latency`, `memory`) writes the header with the thresholds at their defaults; stage 2 plans
# the threshold probes for that header (`-DHEINZEL_BENCH_MACHINE=host`), and the header is written again with everything
# (`header.cmake`). A reading that fails or lies outside its range keeps the field's default, with a warning. Everything
# is kept in <build>/heinzel_tune/: `machine.txt` (measured again at a configure, only when it is missing or its first
# line, the key, changed: a probe edited is measured at the next configure, not by a build; this file, header.cmake or the
# template edited make the next build configure and so measure), and each probe's output and
# build log. Each field's source, rule and range: Plan/24-machine-tuning/01-Fields.md.

if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "HEINZEL_AUTOTUNE measures the machine CMake runs on, and a cross-compile's target is another "
        "one (a probe run under an emulator measures the emulator). Configure with the option on the target itself and "
        "copy its heinzel_tune/include/heinzel/host_machine.hpp, or name a Machine; or turn HEINZEL_AUTOTUNE off.")
endif()

set(_tune_src ${CMAKE_CURRENT_LIST_DIR})
set(_tune_dir ${PROJECT_BINARY_DIR}/heinzel_tune)
set(_tune_txt ${_tune_dir}/machine.txt)
set(_tune_new ${_tune_dir}/machine.txt.new)
set(HEINZEL_TUNE_INCLUDE_DIR ${_tune_dir}/include) # where `heinzel/host_machine.hpp` is written

include(${_tune_src}/header.cmake) # `Machine`'s fields, and the header's writer

# What each probe reads, and the grid of each threshold (the arrays in its source): a reading off it is none the probe
# can make. band_bytes's follows the caches and is set after stage 1.
set(_tune_reads_latency fp_per_cycle add multiply_add divide divide_double root root_double core core_double shuffle
    forwarded loads_per_cycle stores_per_cycle)
set(_tune_reads_memory memory_bytes)
set(_tune_reads_recompute recompute_always recompute_if_uncached)
set(_tune_reads_band_bytes band_bytes)
set(_tune_reads_stream_rows band_stream_rows)
set(_tune_reads_turn turn_pays_after)
set(_tune_reads_parallel_work parallel_work)
set(_tune_reads_window window)
set(_tune_grid_recompute_always 0 2 4 8 16 32 64)
set(_tune_grid_recompute_if_uncached 0 2 4 8 16 32 64)
set(_tune_grid_band_stream_rows 0 4 8 16 32 64 128)
set(_tune_grid_turn_pays_after 1 2 4 8 16 32 64)
set(_tune_grid_parallel_work 1)
foreach(_i RANGE 1 30)
    math(EXPR _p "1 << ${_i}")
    list(APPEND _tune_grid_parallel_work ${_p})
endforeach()

# The build's flags: CMAKE_CXX_FLAGS and its build type's (Release's -O3 -DNDEBUG, or a -march put there), before each
# probe's own -O, which wins. CMAKE_CXX_COMPILER_TARGET and CMAKE_OSX_ARCHITECTURES are not followed: a target named
# there and not in the flags is not what the facts and the probes see.
string(TOUPPER "${CMAKE_BUILD_TYPE}" _tune_config)
string(STRIP "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${_tune_config}}" _tune_build_flags)
# The runtime's multiply-add and roots are the instructions only with the hardware twins on: the probes time what it runs.
if(NOT HEINZEL_HARDWARE_TWINS)
    string(APPEND _tune_build_flags " -DHEINZEL_HARDWARE_TWINS=0")
endif()
get_property(_tune_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_tune_multi AND "${CMAKE_BUILD_TYPE}" STREQUAL "")
    message(WARNING "HEINZEL_AUTOTUNE: a multi-config generator, so only CMAKE_CXX_FLAGS count as the build's flags; a "
        "-march in a configuration's flags is not what host describes")
endif()
separate_arguments(_tune_cxx_flags UNIX_COMMAND "${_tune_build_flags}")
# CMake gives its own compiles the SDK, not a command run here: without it a compiler that finds none itself (Homebrew's
# clang) finds no C++ headers on a Mac unless SDKROOT is exported (as m1/run.sh does).
if(APPLE AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
    list(APPEND _tune_cxx_flags -isysroot ${CMAKE_OSX_SYSROOT})
endif()
set(_tune_flags ${_tune_cxx_flags} ${_std_flag} -DNDEBUG ${HEINZEL_CONSTEXPR_BUDGET_FLAG} -ffp-contract=off -Wno-psabi
    -I${PROJECT_SOURCE_DIR}/include -I${PROJECT_SOURCE_DIR}/app -I${PROJECT_SOURCE_DIR}/tests/support -I${_tune_src})
find_program(HEINZEL_TASKSET taskset)
cmake_host_system_information(RESULT _tune_logical QUERY NUMBER_OF_LOGICAL_CORES)

function(_tune_take field value source)
    file(APPEND ${_tune_new} "tuned ${field} ${value} ${source}\n")
endfunction()

# A default by design: no warning.
function(_tune_keep field why)
    file(APPEND ${_tune_new} "default ${field} ${why}\n")
endfunction()

# A default because the reading failed.
function(_tune_failed field why)
    _tune_keep(${field} "${why}")
    message(WARNING "heinzel::host: ${field} keeps its default: ${why}")
endfunction()

# Why `value` is no plausible reading of `field`, or "" (01-Fields.md "Range checks before a value is written").
function(_tune_implausible field value out)
    set(why "")
    if(field IN_LIST _tune_costs)
        set(lo 1)
        if(field STREQUAL "shuffle")
            set(lo 0)
        endif()
        set(why "a latency of ${lo}-1000 cycles and 1-1000 slots")
        if(value MATCHES "^([0-9]+) ([0-9]+)$")
            if(CMAKE_MATCH_1 GREATER_EQUAL lo AND CMAKE_MATCH_1 LESS_EQUAL 1000 AND CMAKE_MATCH_2 GREATER_EQUAL 1
               AND CMAKE_MATCH_2 LESS_EQUAL 1000)
                set(why "")
            endif()
        endif()
    elseif(NOT value MATCHES "^[0-9]+$")
        set(why "a whole number")
    elseif(DEFINED _tune_grid_${field})
        if(NOT value IN_LIST _tune_grid_${field})
            list(JOIN _tune_grid_${field} ", " grid)
            set(why "one of its probe's grid (${grid})")
        endif()
    elseif(field MATCHES "^(fp_per_cycle|loads_per_cycle|stores_per_cycle|memory_bytes)$")
        if(value LESS 1 OR value GREATER 16)
            set(why "a rate of 1-16")
        endif()
    elseif(field STREQUAL "window")
        if(value LESS 25 OR value GREATER 1000)
            set(why "a window of 25-1000 slots")
        endif()
    elseif(field STREQUAL "forwarded")
        if(value LESS 1 OR value GREATER 1000)
            set(why "a latency of 1-1000 cycles")
        endif()
    elseif(field STREQUAL "line_bytes")
        if(value LESS 32 OR value GREATER 256)
            set(why "32-256 bytes")
        endif()
    elseif(field STREQUAL "page_bytes")
        if(value LESS 4096 OR value GREATER 65536)
            set(why "4 KiB-64 KiB")
        endif()
    elseif(field STREQUAL "cores")
        if(value LESS 1)
            set(why "1 or more")
        endif()
    endif()
    set(${out} "${why}" PARENT_SCOPE)
endfunction()

# Takes `value` for `field`, or keeps its default with a warning where it is no plausible reading.
function(_tune_offer field value source)
    _tune_implausible(${field} "${value}" why)
    if(value STREQUAL "")
        _tune_failed(${field} "${source} gave no reading")
    elseif(why)
        _tune_failed(${field} "${source} read '${value}', not ${why}")
    else()
        _tune_take(${field} "${value}" ${source})
    endif()
endfunction()

# The instruction set the build compiles for: the compiler's macros under its flags (as on `main`; the gate
# `no_instruction_set_macros` forbids asking in include/ only). vector_bytes is 16, 32 or 64 by construction.
function(_tune_isa)
    execute_process(COMMAND ${CMAKE_CXX_COMPILER} ${_tune_cxx_flags} ${_std_flag} -dM -E -x c++ /dev/null
                    RESULT_VARIABLE rc OUTPUT_VARIABLE macros ERROR_QUIET)
    if(NOT rc EQUAL 0)
        foreach(field vector_bytes registers fma)
            _tune_failed(${field} "the compiler's macros could not be read (${rc})")
        endforeach()
        return()
    endif()
    set(vector 16)
    set(registers 16)
    if(macros MATCHES "#define __AVX512F__ ")
        set(vector 64)
        set(registers 32)
    elseif(macros MATCHES "#define __AVX__ ")
        set(vector 32)
    elseif(macros MATCHES "#define __aarch64__ ")
        set(registers 32)
    endif()
    set(fma false)
    if(macros MATCHES "#define (__FMA__|__ARM_FEATURE_FMA) ")
        set(fma true)
    endif()
    _tune_take(vector_bytes ${vector} compiler)
    _tune_take(registers ${registers} compiler)
    _tune_take(fma ${fma} compiler)
endfunction()

function(_tune_ask out)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE text OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Caches, line, page and cores as one core sees them: sysfs on Linux (one CCX's L3 on Zen), getconf where sysfs gives
# no sizes, sysctl on macOS (an Apple processor's performance cores, an Intel Mac's cores). A machine that reports no L3
# (an Apple processor) gets l3_bytes = l2_bytes, as on `main`. Sets _tune_l1, _tune_l2, _tune_l3 and _tune_cores to
# `host`'s values, a default where a reading failed.
function(_tune_os)
    foreach(v l1 l2 l3 line page cores)
        set(${v} "")
    endforeach()
    set(from getconf)
    set(page_from getconf)
    set(cores_from cmake)
    if(APPLE)
        set(from sysctl)
        set(page_from sysctl)
        set(cores_from sysctl)
        _tune_ask(l1 sysctl -n hw.perflevel0.l1dcachesize)
        _tune_ask(l2 sysctl -n hw.perflevel0.l2cachesize)
        _tune_ask(l3 sysctl -n hw.perflevel0.l3cachesize) # an Intel Mac on macOS 12 or later; an Apple processor has none
        _tune_ask(cores sysctl -n hw.perflevel0.physicalcpu)
        if(l1 STREQUAL "") # an Intel Mac before macOS 12: one kind of core, and an L3
            _tune_ask(l1 sysctl -n hw.l1dcachesize)
            _tune_ask(l2 sysctl -n hw.l2cachesize)
            _tune_ask(l3 sysctl -n hw.l3cachesize)
            _tune_ask(cores sysctl -n hw.physicalcpu)
        endif()
        _tune_ask(line sysctl -n hw.cachelinesize)
        _tune_ask(page sysctl -n hw.pagesize)
    elseif(EXISTS /sys/devices/system/cpu/cpu0/cache/index0/size)
        set(from sysfs)
        file(GLOB dirs /sys/devices/system/cpu/cpu0/cache/index*)
        foreach(dir IN LISTS dirs)
            # The kernel hides a value it does not know (an arm64 board's firmware may give no sizes): left "", it
            # fails the checks below, and the field keeps its default with a warning.
            foreach(name type level size coherency_line_size)
                set(${name} "")
                if(EXISTS ${dir}/${name})
                    file(STRINGS ${dir}/${name} ${name})
                endif()
            endforeach()
            if(type STREQUAL "Instruction" OR NOT level MATCHES "^[123]$")
                continue()
            endif()
            if(size MATCHES "^([0-9]+)K$")
                math(EXPR size "${CMAKE_MATCH_1} * 1024")
            elseif(size MATCHES "^([0-9]+)M$")
                math(EXPR size "${CMAKE_MATCH_1} * 1024 * 1024")
            endif()
            set(l${level} "${size}")
            if(level EQUAL 1)
                set(line "${coherency_line_size}")
            endif()
        endforeach()
        _tune_ask(page getconf PAGESIZE)
    else()
        _tune_ask(l1 getconf LEVEL1_DCACHE_SIZE)
        _tune_ask(l2 getconf LEVEL2_CACHE_SIZE)
        _tune_ask(l3 getconf LEVEL3_CACHE_SIZE)
        _tune_ask(line getconf LEVEL1_DCACHE_LINESIZE)
        _tune_ask(page getconf PAGESIZE)
    endif()
    if(cores STREQUAL "")
        set(cores_from cmake)
        cmake_host_system_information(RESULT cores QUERY NUMBER_OF_PHYSICAL_CORES)
    endif()
    if(l3 STREQUAL "" OR l3 STREQUAL "0")
        set(l3 "${l2}")
    endif()
    set(caches "${l1} ${l2} ${l3}")
    if(caches MATCHES "^[0-9]+ [0-9]+ [0-9]+$" AND l1 LESS l2 AND l2 LESS_EQUAL l3)
        _tune_take(l1_bytes ${l1} ${from})
        _tune_take(l2_bytes ${l2} ${from})
        _tune_take(l3_bytes ${l3} ${from})
    else()
        foreach(field l1_bytes l2_bytes l3_bytes)
            _tune_failed(${field} "${from} read '${caches}' for the three caches, not l1 < l2 <= l3")
        endforeach()
        set(l1 32768) # `Machine`'s defaults
        set(l2 262144)
        set(l3 8388608)
    endif()
    _tune_offer(line_bytes "${line}" ${from})
    _tune_offer(page_bytes "${page}" ${page_from})
    _tune_offer(cores "${cores}" ${cores_from})
    _tune_implausible(cores "${cores}" why)
    if(why OR cores STREQUAL "")
        set(cores 1)
    endif()
    set(_tune_l1 ${l1} PARENT_SCOPE)
    set(_tune_l2 ${l2} PARENT_SCOPE)
    set(_tune_l3 ${l3} PARENT_SCOPE)
    set(_tune_cores ${cores} PARENT_SCOPE)
endfunction()

# The one-minute load average. sysctl in the C locale: a German one prints a decimal comma, which reads as no load.
function(_tune_load out)
    set(load "")
    if(EXISTS /proc/loadavg)
        file(READ /proc/loadavg text)
    else()
        execute_process(COMMAND ${CMAKE_COMMAND} -E env LC_ALL=C sysctl -n vm.loadavg OUTPUT_VARIABLE text ERROR_QUIET)
    endif()
    string(REGEX MATCH "[0-9]+\\.[0-9]+" load "${text}")
    set(${out} "${load}" PARENT_SCOPE)
endfunction()

# Builds `probe` (its stage-2 build plans for the stage-1 header) through the build's compiler launcher, ccache where
# the build uses it, and runs it with ARGN, pinned to `cpus` where taskset can pin and `cpus` is given; its output goes
# to <probe>.txt, its build to <probe>.build.log. Sets _tune_failure to what went wrong, or "".
function(_tune_probe probe stage cpus)
    set(opt -O3 -fno-math-errno)
    set(extra "")
    set(link "")
    if(probe STREQUAL "latency")
        set(opt -O2) # as its header builds it
    elseif(probe STREQUAL "parallel_work")
        set(extra -DHEINZEL_HAVE_THREADS -pthread)
        set(link -pthread)
    endif()
    if(stage EQUAL 2)
        list(APPEND extra -DHEINZEL_BENCH_MACHINE=host -I${HEINZEL_TUNE_INCLUDE_DIR})
    endif()
    set(bin ${_tune_dir}/bin/${probe})
    set(out ${_tune_dir}/${probe}.txt)
    file(MAKE_DIRECTORY ${_tune_dir}/bin)
    string(TIMESTAMP t0 "%s")
    execute_process(COMMAND ${CMAKE_CXX_COMPILER_LAUNCHER} ${CMAKE_CXX_COMPILER} ${_tune_flags} ${opt} ${extra}
                            -c ${_tune_src}/${probe}.cpp -o ${bin}.o
                    RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE log TIMEOUT 1800)
    if(rc EQUAL 0)
        execute_process(COMMAND ${CMAKE_CXX_COMPILER} ${_tune_cxx_flags} ${bin}.o -o ${bin} ${link}
                        RESULT_VARIABLE rc OUTPUT_VARIABLE link_log ERROR_VARIABLE link_log)
        string(APPEND log "${link_log}")
    endif()
    file(WRITE ${_tune_dir}/${probe}.build.log "${log}")
    string(TIMESTAMP t1 "%s")
    set(failure "")
    if(NOT rc EQUAL 0)
        set(failure "did not build (${rc}; ${probe}.build.log)")
        file(WRITE ${out} "${failure}\n")
    else()
        # The configure keeps one thread busy itself (the compiler, the probe before), so a quiet box reads up to 1
        # and its desktop; above 2, more than one other thread is busy (zen2's desktop, 2026-10-10: 0.6-1.45).
        _tune_load(load)
        file(APPEND ${_tune_new} "load ${probe} ${load}\n")
        if(load GREATER 2)
            message(WARNING "heinzel::host: the load average is ${load} before ${probe} runs: a busy machine reads "
                "slow (recorded in the header)")
        endif()
        set(pin "")
        if(_tune_pin AND NOT cpus STREQUAL "")
            set(pin ${_tune_pin} -c ${cpus})
        endif()
        execute_process(COMMAND ${pin} ${bin} ${ARGN} OUTPUT_FILE ${out} ERROR_FILE ${out} RESULT_VARIABLE rc
                        TIMEOUT 900)
        if(NOT rc EQUAL 0)
            set(failure "failed (${rc}; ${probe}.txt)")
        endif()
    endif()
    string(TIMESTAMP t2 "%s")
    math(EXPR built "${t1} - ${t0}")
    math(EXPR ran "${t2} - ${t1}")
    message(STATUS "heinzel::host: ${probe} built in ${built} s, ran in ${ran} s ${failure}")
    math(EXPR total "${_tune_build_s} + ${built}")
    set(_tune_build_s ${total} PARENT_SCOPE)
    math(EXPR total "${_tune_run_s} + ${ran}")
    set(_tune_run_s ${total} PARENT_SCOPE)
    set(_tune_failure "${failure}" PARENT_SCOPE)
endfunction()

# What `probe` read for `field`: its last `tuned <field> ...` line (one starting `untuned` is not a reading), or "".
function(_tune_line probe field out)
    file(STRINGS ${_tune_dir}/${probe}.txt lines REGEX "^tuned ${field} ")
    set(value "")
    if(lines)
        list(GET lines -1 line)
        string(REGEX REPLACE "^tuned ${field} +" "" value "${line}")
        string(STRIP "${value}" value)
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Each field `probe` reads; `none`, no line, a failed probe or an implausible value keep the default, with a warning.
function(_tune_readings probe)
    foreach(field IN LISTS _tune_reads_${probe})
        if(_tune_failure)
            _tune_failed(${field} "${probe} ${_tune_failure}")
            continue()
        endif()
        _tune_line(${probe} ${field} value)
        if(value STREQUAL "none")
            _tune_failed(${field} "${probe} saw no crossing in its sweep")
        else()
            _tune_offer(${field} "${value}" ${probe}.cpp)
        endif()
    endforeach()
endfunction()

# The key: what a measurement depends on. The planner's headers are left out (they change daily, a measurement takes
# minutes); the code here is in, all but its README.
file(GLOB _tune_code ${_tune_src}/*.cpp ${_tune_src}/*.hpp ${_tune_src}/*.cmake ${_tune_src}/*.in)
list(SORT _tune_code)
set(_tune_hashes "")
foreach(_f IN LISTS _tune_code)
    file(SHA256 ${_f} _h)
    get_filename_component(_n ${_f} NAME)
    string(APPEND _tune_hashes "${_n} ${_h}\n")
endforeach()
string(SHA256 _tune_hash "${_tune_hashes}")
get_filename_component(_tune_cxx ${CMAKE_CXX_COMPILER} NAME)
set(_tune_worker_text "${HEINZEL_AUTOTUNE_WORKERS}")
if(_tune_worker_text STREQUAL "")
    set(_tune_worker_text "every core's")
endif()
string(STRIP "${_tune_build_flags} ${_std_flag}" _tune_flag_text)
set(_tune_key "key ${_tune_cxx} ${CMAKE_CXX_COMPILER_VERSION} | ${_tune_flag_text} | threads ${HEINZEL_HAVE_THREADS}, \
${_tune_worker_text} workers | tools/tune sha256 ${_tune_hash}")

# The first line's bytes as written: file(STRINGS) cuts a line at a byte that is not ASCII (a flag naming
# /home/jörg/) and escapes a semicolon, so such flags measured at every configure.
set(_tune_measure TRUE)
if(EXISTS ${_tune_txt})
    string(LENGTH "${_tune_key}\n" _n)
    file(READ ${_tune_txt} _tune_first LIMIT ${_n})
    if(_tune_first STREQUAL "${_tune_key}\n")
        set(_tune_measure FALSE)
    endif()
endif()
if(NOT _tune_measure)
    message(STATUS "heinzel::host: measured before (${_tune_txt}; delete it to measure again)")
    _tune_write_header(${_tune_txt})
    return()
endif()

message(STATUS "heinzel::host: measuring this machine (HEINZEL_AUTOTUNE: minutes, once per build directory)")
string(TIMESTAMP _tune_t0 "%s")
set(_tune_build_s 0)
set(_tune_run_s 0)
string(TIMESTAMP _tune_date "%Y-%m-%d %H:%M")
set(_tune_cpu "")
if(EXISTS /proc/cpuinfo)
    file(STRINGS /proc/cpuinfo _tune_cpu REGEX "^model name" LIMIT_COUNT 1)
    string(REGEX REPLACE "^model name[ \t]*: *" "" _tune_cpu "${_tune_cpu}")
elseif(APPLE)
    _tune_ask(_tune_cpu sysctl -n machdep.cpu.brand_string)
endif()
if(_tune_cpu STREQUAL "")
    set(_tune_cpu "an unnamed processor")
endif()
file(MAKE_DIRECTORY ${_tune_dir})
file(WRITE ${_tune_new} "${_tune_key}\ndate ${_tune_date}\ncpu ${_tune_cpu}\n")
_tune_isa()
_tune_os()

# Where the probes run: HEINZEL_TUNE_CORE, else CPU 4 as on zen2 where there is one, else the last; parallel_work on as
# many CPUs from there as it has workers, unpinned where they do not fit.
set(_tune_core "${HEINZEL_TUNE_CORE}")
if(_tune_core STREQUAL "")
    set(_tune_core 4)
    if(_tune_logical LESS_EQUAL 4)
        math(EXPR _tune_core "${_tune_logical} - 1")
    endif()
endif()
set(_tune_workers "${HEINZEL_AUTOTUNE_WORKERS}")
if(_tune_workers STREQUAL "")
    set(_tune_workers ${_tune_cores})
endif()
math(EXPR _tune_last "${_tune_core} + ${_tune_workers} - 1")
set(_tune_spread "")
if(_tune_last LESS _tune_logical)
    set(_tune_spread "${_tune_core}-${_tune_last}")
endif()
# Pinned only where taskset can pin to that CPU: one it cannot (HEINZEL_TUNE_CORE past the last, a cpuset without it)
# failed every probe.
set(_tune_pin "")
if(HEINZEL_TASKSET)
    execute_process(COMMAND ${HEINZEL_TASKSET} -c ${_tune_core} true RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_QUIET)
    if(_rc EQUAL 0)
        set(_tune_pin ${HEINZEL_TASKSET})
    else()
        message(WARNING "heinzel::host: taskset cannot pin to CPU ${_tune_core} (HEINZEL_TUNE_CORE, or the CPUs this "
            "configure may use): the probes run unpinned")
    endif()
endif()

# Stage 1: the latencies and issue rates, and the memory term over buffers of four times the L3 (256 MiB at least).
_tune_probe(latency 1 ${_tune_core})
_tune_readings(latency)
_tune_probe(memory 1 ${_tune_core} ${_tune_l3})
_tune_readings(memory)
_tune_write_header(${_tune_new})

# Stage 2: the thresholds, each planned for stage 1's `host`.
math(EXPR _tune_l2_8 "${_tune_l2} / 8")
math(EXPR _tune_l2_4 "${_tune_l2} / 4")
math(EXPR _tune_l2_2 "${_tune_l2} / 2")
set(_tune_grid_band_bytes ${_tune_l1} ${_tune_l2_8} ${_tune_l2_4} ${_tune_l2_2} ${_tune_l2})
# relay runs and its reading is kept (relay.txt, and machine.txt's line), but `host` keeps relay_pays_after's default
# (Gerald, Plan 24 answer 11): the probe's B, 256 KiB, fits the L2, and the planner's rule counts blocks of rows, not
# B's bytes (`loops/planner/contraction.hpp` `relay_where_it_pays`). On zen2 its 24 cost ml/linear_relu 1.50x and
# ml/mlp2 1.25-1.30x, whose B does not fit the L2.
_tune_probe(relay 2 ${_tune_core})
_tune_line(relay relay_pays_after _tune_relay)
if(_tune_failure)
    set(_tune_relay "relay ${_tune_failure}")
elseif(_tune_relay STREQUAL "")
    set(_tune_relay "relay.cpp gave no reading")
else()
    set(_tune_relay "relay.cpp read ${_tune_relay}")
endif()
_tune_keep(relay_pays_after "${_tune_relay}, recorded, not taken: its B fits the L2, and the rule counts blocks of rows, \
not B's bytes (planner/contraction.hpp relay_where_it_pays; on zen2 24 cost ml/linear_relu 1.50x, ml/mlp2 1.25-1.30x)")
message(STATUS "heinzel::host: relay_pays_after keeps its default (${_tune_relay}; its B fits the L2, the rule counts \
blocks of rows, not B's bytes)")
foreach(_probe recompute band_bytes stream_rows turn window)
    _tune_probe(${_probe} 2 ${_tune_core})
    _tune_readings(${_probe})
endforeach()
if(NOT HEINZEL_HAVE_THREADS)
    _tune_keep(parallel_work "threads are off in this build")
else()
    _tune_probe(parallel_work 2 "${_tune_spread}" ${_tune_workers})
    if(_tune_workers EQUAL _tune_cores)
        _tune_readings(parallel_work)
    else()
        _tune_keep(parallel_work "measured with ${_tune_workers} workers, not the machine's ${_tune_cores} cores, and \
the count matters (parallel_work.txt)")
        message(STATUS "heinzel::host: parallel_work keeps its default (${_tune_workers} workers, ${_tune_cores} cores)")
    endif()
endif()

_tune_keep(band_when_over "15/16 of l3_bytes: its probe takes minutes (Plan/probes/thresholds/band_when_over.cpp)")
_tune_keep(contention "fitted on the cost-model corpus; no probe decides it in seconds")
_tune_keep(stage_start "its probe cuts zen2's schedule by hand (Plan/probes/audio-iir/stage_start.cpp)")
_tune_keep(merge_work "measured on the cost-model corpus; no probe decides it in seconds")
file(RENAME ${_tune_new} ${_tune_txt})
_tune_write_header(${_tune_txt})
string(TIMESTAMP _tune_t1 "%s")
math(EXPR _tune_s "${_tune_t1} - ${_tune_t0}")
message(STATUS "heinzel::host: measured in ${_tune_s} s (building ${_tune_build_s} s, running ${_tune_run_s} s); \
${HEINZEL_TUNE_INCLUDE_DIR}/heinzel/host_machine.hpp")
