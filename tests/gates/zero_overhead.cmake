# `Plan/15-zero-overhead/01`, "The gates": an `Executor` costs at most LIMIT over the run it wraps, in bytes (B, `text +
# data + bss` of the size build, read with `llvm-size -B`) or in instructions per run (I, which each `_count` build
# prints; there LIMIT or 0.1 % of the reference, whichever is more: Gerald, 2026-10-05, a difference that small is no
# cost worth chasing, and a long run's code layout alone moves it, as a padding `nop` that lands inside a loop does). The reference is the bare arm plus its copy out; in I, for a workload in ZERO_COPY (every output written in
# the caller's memory, `Plan/18-zero-copy/02`), the bare arm, which copies nothing either. A workload whose program
# says otherwise (`Z` in its count: every output in `loops::kInPlaceOf`) fails. Every row is printed, the hand loop beside it, and a row
# over LIMIT fails. B compares whole binaries, the harness's own code included, which the inliner lays out differently
# in each arm, so a row's delta is pinned as well: BASE gives each row's delta as recorded ("w1:45 w3:-604 …"), and a
# row may move at most 32 B from it either way (the review of Plan/15: one limit alone left W3 700 B of room; the review
# of L12: an output copied again shrinks its row). B also holds each `Executor` built at -O1, at -Os and with asserts on
# (`zo_<w>_executor_o1`, `_os`, `_checked`) under 32 KiB: a compile result that reaches a binary takes 100 KB or more.
#
# SAME pairs a workload with another whose release program it is ("w11:w1": W1 with ranges, Plan/26-value-ranges/04): its
# `Executor` has the other's bytes exactly, and its instructions within LIMIT of the other's.
#
# A `_count` build that cannot count (perf refused, a count of zero, a multiplexed counter) exits 77. With no row over
# LIMIT, the gate then prints `zero_overhead_runtime: SKIPPED: <why>` and stops, which the test's
# SKIP_REGULAR_EXPRESSION reads (`cmake -P` cannot exit 77). A skip is no pass: counting needs
# `kernel.perf_event_paranoid` <= 2.
#
#   cmake -DKIND=binary|runtime -DDIR=<executables> -DWORKLOADS="w1 w2 …" -DLIMIT=<n> [-DSIZE=<llvm-size> -DBASE="w1:45 …"]
#         [-DZERO_COPY="w1 …"] [-DSAME="w11:w1 …"] -P zero_overhead.cmake

cmake_minimum_required(VERSION 3.25) # (CMP0054: a quoted "hand" is no variable, though one is named so below)
separate_arguments(WORKLOADS)
separate_arguments(BASE)
separate_arguments(ZERO_COPY)
separate_arguments(SAME)
if(NOT LIMIT MATCHES "^[0-9]+$" OR WORKLOADS STREQUAL "")
    message(FATAL_ERROR "zero_overhead: LIMIT (${LIMIT}) is no count, or WORKLOADS is empty: a gate that compared nothing would pass")
endif()
set(_arms hand bare bare_copy executor)
set(_name zero_overhead_${KIND})

# B of one executable, or its I in tenths of an instruction (`%.1f`); empty, with `_why` set, for a count that could not.
function(measure workload arm out)
    set(exe ${DIR}/zo_${workload}_${arm})
    set(file ${exe})
    if(KIND STREQUAL "runtime")
        set(file ${exe}_count)
    endif()
    if(NOT EXISTS ${file})
        if(NOT arm STREQUAL "hand") # (W9 and W12 have no hand loop)
            message(FATAL_ERROR "${_name}: no ${file}: a gate that measured nothing would pass")
        endif()
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    if(KIND STREQUAL "binary")
        execute_process(COMMAND ${SIZE} -B ${exe} OUTPUT_VARIABLE text RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0 OR NOT text MATCHES "\n[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[0-9]+[ \t]+([0-9]+)")
            message(FATAL_ERROR "${_name}: ${SIZE} could not read ${exe}")
        endif()
        set(${out} ${CMAKE_MATCH_1} PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND ${exe}_count OUTPUT_VARIABLE text RESULT_VARIABLE rc)
    if(rc EQUAL 77)
        string(REGEX REPLACE "^SKIP |\n$" "" why "${text}")
        set(_why "${why}" PARENT_SCOPE)
        set(${out} "" PARENT_SCOPE)
    elseif(NOT rc EQUAL 0 OR NOT text MATCHES "^I (-?[0-9]+)\\.([0-9]) .* Z ([01])")
        message(FATAL_ERROR "${_name}: ${exe}_count failed (${rc}): ${text}")
    else()
        set(${out} ${CMAKE_MATCH_1}${CMAKE_MATCH_2} PARENT_SCOPE)
        set(_z ${CMAKE_MATCH_3} PARENT_SCOPE)
    endif()
endfunction()

# Tenths as an instruction count, "127.5"; bytes as they are.
function(shown value out)
    if(KIND STREQUAL "runtime" AND NOT value STREQUAL "")
        math(EXPR whole "${value} / 10")
        math(EXPR tenth "${value} % 10")
        string(REPLACE "-" "" tenth "${tenth}")
        if(value LESS 0 AND whole EQUAL 0)
            set(whole "-0")
        endif()
        set(value "${whole}.${tenth}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

if(KIND STREQUAL "binary")
    set(limit ${LIMIT})
    message("${_name}: B in bytes; the Executor at most +${LIMIT} over bare + copy")
else()
    math(EXPR limit "${LIMIT} * 10")
    message("${_name}: I in instructions per run; the Executor at most +${LIMIT} or 0.1 % over bare + copy (over bare: zero-copy)")
endif()
message("| workload | hand | bare | bare + copy | Executor | Executor over its reference |")
set(_why "")
set(over "")
foreach(w IN LISTS WORKLOADS)
    set(row "| ${w}")
    foreach(a IN LISTS _arms)
        measure(${w} ${a} ${a})
        shown("${${a}}" cell)
        if(cell STREQUAL "")
            set(cell "–")
        endif()
        string(APPEND row " | ${cell}")
    endforeach()
    if(bare_copy STREQUAL "" OR executor STREQUAL "")
        message("${row} | – |")
        continue()
    endif()
    set(reference ${bare_copy})
    if(KIND STREQUAL "runtime")
        list(FIND ZERO_COPY ${w} listed)
        if(listed GREATER_EQUAL 0 AND NOT _z EQUAL 1 OR listed LESS 0 AND _z EQUAL 1)
            message(FATAL_ERROR "${_name}: ${w}'s Executor says Z ${_z}, and ZERO_COPY says otherwise: the list is out of date")
        endif()
        if(_z EQUAL 1)
            set(reference ${bare})
            string(APPEND row " (zero-copy)")
        endif()
    endif()
    if(NOT reference GREATER 0)
        message(FATAL_ERROR "${_name}: ${w}'s reference measured ${reference}: nothing was measured")
    endif()
    math(EXPR delta "${executor} - ${reference}")
    set(row_limit ${limit})
    if(KIND STREQUAL "runtime")
        math(EXPR relative "${reference} / 1000") # 0.1 %, in tenths as the counts are
        if(relative GREATER row_limit)
            set(row_limit ${relative})
        endif()
    endif()
    if(KIND STREQUAL "binary")
        set(pinned ${BASE})
        list(FILTER pinned INCLUDE REGEX "^${w}:")
        if(NOT pinned MATCHES "^${w}:(-?[0-9]+)$")
            message(FATAL_ERROR "${_name}: BASE gives ${w} no recorded delta")
        endif()
        math(EXPR grown "${CMAKE_MATCH_1} + 32")
        math(EXPR shrunk "${CMAKE_MATCH_1} - 32")
        if(grown LESS row_limit)
            set(row_limit ${grown})
        endif()
        if(delta LESS shrunk)
            list(APPEND over "${w} ${delta} B, more than 32 B below its pin ${CMAKE_MATCH_1}: re-pin it, and say why")
        endif()
        foreach(build o1 os checked)
            measure(${w} executor_${build} other)
            if(other GREATER 32768)
                list(APPEND over "${w} built ${build}: ${other} B, the compile result")
            endif()
        endforeach()
    endif()
    shown("${delta}" cell)
    if(delta GREATER_EQUAL 0)
        set(cell "+${cell}")
    endif()
    if(delta GREATER row_limit)
        shown("${row_limit}" most)
        if(row_limit GREATER_EQUAL 0)
            set(most "+${most}")
        endif()
        list(APPEND over "${w} ${cell} (at most ${most})")
        message("${row} | ${cell} OVER |")
    else()
        message("${row} | ${cell} |")
    endif()
endforeach()

foreach(pair IN LISTS SAME)
    if(NOT pair MATCHES "^(w[0-9]+):(w[0-9]+)$")
        message(FATAL_ERROR "${_name}: SAME's ${pair} is no pair of workloads")
    endif()
    set(twin ${CMAKE_MATCH_1})
    set(of ${CMAKE_MATCH_2})
    measure(${twin} executor mine)
    measure(${of} executor theirs)
    if(mine STREQUAL "" OR theirs STREQUAL "")
        continue() # (a count that could not: the skip below says why)
    endif()
    math(EXPR apart "${mine} - ${theirs}")
    shown("${mine}" a)
    shown("${theirs}" b)
    message("${twin}'s Executor ${a} against ${of}'s ${b}")
    if(KIND STREQUAL "binary" AND NOT apart EQUAL 0 OR apart GREATER limit OR apart LESS -${limit})
        list(APPEND over "${twin}'s Executor ${a} against ${of}'s ${b}, whose release program it is")
    endif()
endforeach()

if(over)
    list(JOIN over ", " over)
    message(FATAL_ERROR "${_name}: over its limit: ${over}")
endif()
if(NOT _why STREQUAL "")
    message(FATAL_ERROR "${_name}: SKIPPED: ${_why}")
endif()
message("${_name}: every row within +${LIMIT}")
